# Configure ONLY in Vercel > Settings > Environment Variables. No real secrets here.
APP_ENV=staging
APP_URL=https://REPLACE_WITH_ACTUAL_ASSIGNED_DOMAIN
STAGING_SUPABASE_PROJECT_REF=REPLACE_WITH_TEST_PROJECT_REF
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_WITH_TEST_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_TEST_ANON_OR_PUBLISHABLE_KEY
AI_ENABLED=false
MP_SANDBOX_ENABLED=false
# true only after remote worker starts and an actual document passes through the queue
OCR_WORKER_ENABLED=false
