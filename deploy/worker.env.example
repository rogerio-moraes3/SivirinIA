# Copy to /etc/sivirinia/worker.env on the worker host, chmod 600.
APP_ENV=staging
STAGING_SUPABASE_PROJECT_REF=REPLACE_WITH_TEST_PROJECT_REF
WORKER_DATABASE_URL=postgresql://sivirinia_worker:URL_ENCODED_PASSWORD@db.REPLACE_WITH_TEST_PROJECT_REF.supabase.co:5432/postgres
# If needed, mount the CA from the Supabase dashboard and set WORKER_CA_FILE.
AI_ENABLED=false
