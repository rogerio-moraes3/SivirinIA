# Em produção, informe a origem HTTPS real. No desenvolvimento, apenas localhost/127.0.0.1:3000 são aceitos sem APP_URL.
APP_URL=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Gerado localmente por npm run env:local. Nunca use service_role aqui.
# IA é opcional para a busca citada; sem chave, o sistema entrega trechos, sem simular geração.
AI_ENABLED=false
AI_API_KEY=
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
# Proteção adicional para recursos públicos futuros. Não publicar sem configurar.

# Worker dedicado: configure somente no processo worker/gerenciador de segredos.
# Local: npm run db:start provisiona .local/worker.env (ignorado).
# WORKER_DATABASE_URL=
# Tarifas atuais do modelo autorizado. Ausência bloqueia chamadas, sem assumir custo zero.
AI_EMBEDDING_USD_PER_MILLION=
# Limites conservadores anteriores à chamada; não são medição real de tokens.
AI_MAX_INPUT_TOKENS=16000
AI_MAX_OUTPUT_TOKENS=1000
AI_MAX_EMBEDDING_TOKENS=16000
AI_MAX_REQUEST_USD=0.01
AI_MAX_INGESTION_USD=0.10
# Preparação de leitura/verificação Mercado Pago. Sem checkout/recorrência conectados.
MP_SANDBOX_ENABLED=false
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
